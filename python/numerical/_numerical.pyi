"""The C++ extension behind :mod:`numerical`: the Tensor type and the native kernels the package wraps."""
from collections.abc import Iterator, Sequence
from typing import Any, ClassVar, Literal, NoReturn, final

_Dtype = Literal["float64", "complex128"]
_Number = float | complex
_Shape = tuple[int, ...]

class error(Exception): ...

@final
class Tensor:
    def __init__(self, data: Any, shape: Sequence[int] | None = None, dtype: _Dtype = "float64") -> None: ...
    def __dlpack__(self, stream: Any = None) -> Any: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...
    def tolist(self) -> Any: ...
    @property
    def shape(self) -> _Shape: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def dtype(self) -> _Dtype: ...
    @property
    def __array_interface__(self) -> dict[str, Any]: ...
    # Defined by the numerical package at import.
    __hash__: ClassVar[None]  # type: ignore[assignment]
    @property
    def T(self) -> Tensor: ...
    def __getitem__(self, key: Any) -> Tensor | _Number: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Tensor | _Number]: ...
    def __matmul__(self, other: Any) -> Tensor | _Number: ...
    def __rmatmul__(self, other: Any) -> Tensor | _Number: ...
    def __bool__(self) -> bool: ...
    def __float__(self) -> float: ...
    def __complex__(self) -> complex: ...
    def __int__(self) -> int: ...
    def __eq__(self, other: object) -> NoReturn: ...  # type: ignore[override]
    def __ne__(self, other: object) -> NoReturn: ...  # type: ignore[override]
    def __lt__(self, other: object) -> NoReturn: ...
    def __le__(self, other: object) -> NoReturn: ...
    def __gt__(self, other: object) -> NoReturn: ...
    def __ge__(self, other: object) -> NoReturn: ...
    def __add__(self, other: Any) -> Tensor: ...
    def __radd__(self, other: Any) -> Tensor: ...
    def __sub__(self, other: Any) -> Tensor: ...
    def __rsub__(self, other: Any) -> Tensor: ...
    def __mul__(self, other: Any) -> Tensor: ...
    def __rmul__(self, other: Any) -> Tensor: ...
    def __truediv__(self, other: Any) -> Tensor: ...
    def __rtruediv__(self, other: Any) -> Tensor: ...
    def __pow__(self, other: Any) -> Tensor: ...
    def __rpow__(self, other: Any) -> Tensor: ...
    def __abs__(self) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __pos__(self) -> Tensor: ...
    def sum(self, axis: int | None = None) -> Tensor | _Number: ...
    def mean(self, axis: int | None = None) -> Tensor | _Number: ...
    def max(self, axis: int | None = None) -> Tensor | float: ...
    def min(self, axis: int | None = None) -> Tensor | float: ...
    def reshape(self, *shape: int | Sequence[int]) -> Tensor: ...

def _set_num_threads(n: int, /) -> None: ...
def get_num_threads() -> int: ...
def _limit_gemm_path(code: int, /) -> int: ...
def _gemm_path() -> int: ...
def _amx_probed() -> bool: ...
def solve(a: Tensor, b: Tensor, /) -> Tensor: ...
def inverse(a: Tensor, /) -> Tensor: ...
def lstsq(a: Tensor, b: Tensor, /) -> tuple[Tensor, Tensor, int, Tensor]: ...
def cholesky(a: Tensor, /) -> Tensor: ...
def qr(a: Tensor, /) -> tuple[Tensor, Tensor]: ...
def eigh(a: Tensor, method: str, /) -> tuple[Tensor, Tensor]: ...
def matrix_rank(a: Tensor, /) -> int: ...
def pinv(a: Tensor, /) -> Tensor: ...
def svd(a: Tensor, method: str, /) -> tuple[Tensor, Tensor, Tensor]: ...
def determinant(*args: Any) -> _Number: ...
def _take(*args: Any) -> Tensor | _Number: ...
def _binary(*args: Any) -> Tensor: ...
def _negate(*args: Any) -> Tensor: ...
def _equal(*args: Any) -> bool: ...
def _unary(*args: Any) -> Tensor: ...
def _reduce(*args: Any) -> Tensor | _Number: ...
def _reshape(*args: Any) -> Tensor: ...
def _full(*args: Any) -> Tensor: ...
def _eye(*args: Any) -> Tensor: ...
def _arange(*args: Any) -> Tensor: ...
def _linspace(*args: Any) -> Tensor: ...
def slogdet(*args: Any) -> tuple[_Number, float]: ...
def einsum(*args: Any) -> Tensor: ...
def asarray(obj: Any, dtype: _Dtype | None = None) -> Tensor: ...
