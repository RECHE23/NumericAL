"""The C++ extension behind :mod:`numerical`: the Tensor type and the native kernels the package wraps."""
from collections.abc import Iterator, Sequence
from typing import Any, ClassVar, Literal, NoReturn, final

_Dtype = Literal["float64", "complex128", "float32", "complex64", "bool"]
_Number = float | complex | bool
_Shape = tuple[int, ...]

class error(Exception): ...

@final
class Tensor:
    def __init__(self, data: Any, shape: Sequence[int] | None = None, dtype: _Dtype = "float64") -> None: ...
    def __dlpack__(self, stream: Any = None) -> Any: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...
    def tolist(self) -> Any: ...
    @property
    def shape(self) -> _Shape: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def dtype(self) -> _Dtype: ...
    @property
    def __array_interface__(self) -> dict[str, Any]: ...
    # Defined by the numerical package at import.
    __hash__: ClassVar[None]  # type: ignore[assignment]
    @property
    def T(self) -> Tensor: ...
    def __getitem__(self, key: Any) -> Tensor | _Number: ...
    def __setitem__(self, key: Any, value: Any) -> NoReturn: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Tensor | _Number]: ...
    def __matmul__(self, other: Any, /) -> Tensor | _Number: ...
    def __rmatmul__(self, other: Any) -> Tensor | _Number: ...
    def __bool__(self) -> bool: ...
    def __float__(self) -> float: ...
    def __complex__(self) -> complex: ...
    def __int__(self) -> int: ...
    def __eq__(self, other: object) -> Tensor: ...  # type: ignore[override]
    def __ne__(self, other: object) -> Tensor: ...  # type: ignore[override]
    def __lt__(self, other: object) -> Tensor: ...
    def __le__(self, other: object) -> Tensor: ...
    def __gt__(self, other: object) -> Tensor: ...
    def __ge__(self, other: object) -> Tensor: ...
    def __and__(self, other: Any) -> Tensor: ...
    def __rand__(self, other: Any) -> Tensor: ...
    def __or__(self, other: Any) -> Tensor: ...
    def __ror__(self, other: Any) -> Tensor: ...
    def __xor__(self, other: Any) -> Tensor: ...
    def __rxor__(self, other: Any) -> Tensor: ...
    def __invert__(self) -> Tensor: ...
    def __add__(self, other: Any) -> Tensor: ...
    def __radd__(self, other: Any) -> Tensor: ...
    def __sub__(self, other: Any) -> Tensor: ...
    def __rsub__(self, other: Any) -> Tensor: ...
    def __mul__(self, other: Any) -> Tensor: ...
    def __rmul__(self, other: Any) -> Tensor: ...
    def __truediv__(self, other: Any) -> Tensor: ...
    def __rtruediv__(self, other: Any) -> Tensor: ...
    def __pow__(self, other: Any) -> Tensor: ...
    def __rpow__(self, other: Any) -> Tensor: ...
    def __abs__(self) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __pos__(self) -> Tensor: ...
    def sum(self, axis: int | tuple[int, ...] | None = None, dtype: Any = None, out: None = None, keepdims: bool = False) -> Tensor | _Number: ...
    def mean(self, axis: int | tuple[int, ...] | None = None, dtype: Any = None, out: None = None, keepdims: bool = False) -> Tensor | _Number: ...
    def max(self, axis: int | tuple[int, ...] | None = None, dtype: Any = None, out: None = None, keepdims: bool = False) -> Tensor | float | bool: ...
    def min(self, axis: int | tuple[int, ...] | None = None, dtype: Any = None, out: None = None, keepdims: bool = False) -> Tensor | float | bool: ...
    def any(self, axis: int | tuple[int, ...] | None = None, dtype: Any = None, out: None = None, keepdims: bool = False) -> Tensor | bool: ...
    def all(self, axis: int | tuple[int, ...] | None = None, dtype: Any = None, out: None = None, keepdims: bool = False) -> Tensor | bool: ...
    def astype(self, dtype: Any) -> Tensor: ...
    def __reduce__(self) -> tuple[Any, tuple[bytes, _Shape, _Dtype, str]]: ...
    def __copy__(self) -> Tensor: ...
    def __deepcopy__(self, memo: Any) -> Tensor: ...
    def __contains__(self, value: object) -> bool: ...
    def copy(self) -> Tensor: ...
    def tobytes(self) -> bytes: ...
    def transpose(self, *axes: Any) -> Tensor: ...
    def swapaxes(self, axis1: int, axis2: int) -> Tensor: ...
    @property
    def mT(self) -> Tensor: ...
    def flatten(self) -> Tensor: ...
    def ravel(self) -> Tensor: ...
    def squeeze(self, axis: int | tuple[int, ...] | None = None) -> Tensor: ...
    def item(self, *args: Any) -> _Number: ...
    @property
    def real(self) -> Tensor: ...
    @property
    def imag(self) -> Tensor: ...
    def conj(self) -> Tensor: ...
    def conjugate(self) -> Tensor: ...
    def diagonal(self, offset: int = 0, axis1: int = 0, axis2: int = 1) -> Tensor: ...
    def trace(self, offset: int = 0, axis1: int = 0, axis2: int = 1, dtype: Any = None, out: None = None) -> Tensor | _Number: ...
    def dot(self, b: Any) -> Tensor | _Number: ...
    @property
    def itemsize(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def device(self) -> str: ...
    def to_device(self, device: str, /, *, stream: Any = None) -> Tensor: ...
    def reshape(self, *shape: int | Sequence[int]) -> Tensor: ...

