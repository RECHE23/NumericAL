from collections.abc import Sequence
from typing import Any, Literal

from numerical._numerical import Tensor

__all__ = ["fft", "ifft", "fft2", "ifft2", "fftn", "ifftn", "rfft", "irfft", "rfft2", "irfft2", "rfftn", "irfftn", "hfft",
           "ihfft", "fftfreq", "rfftfreq", "fftshift", "ifftshift"]

_Norm = Literal["backward", "ortho", "forward"] | None

def fft(a: Any, n: int | None = None, axis: int = -1, norm: _Norm = None, out: None = None) -> Tensor: ...
def ifft(a: Any, n: int | None = None, axis: int = -1, norm: _Norm = None, out: None = None) -> Tensor: ...
def fftn(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] | None = None, norm: _Norm = None,
         out: None = None) -> Tensor: ...
def ifftn(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] | None = None, norm: _Norm = None,
          out: None = None) -> Tensor: ...
def fft2(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] = (-2, -1), norm: _Norm = None,
         out: None = None) -> Tensor: ...
def ifft2(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] = (-2, -1), norm: _Norm = None,
          out: None = None) -> Tensor: ...
def fftfreq(n: int, d: float = 1.0, device: str | None = None) -> Tensor: ...
def rfftfreq(n: int, d: float = 1.0, device: str | None = None) -> Tensor: ...
def fftshift(x: Any, axes: int | Sequence[int] | None = None) -> Tensor: ...
def ifftshift(x: Any, axes: int | Sequence[int] | None = None) -> Tensor: ...
def rfft(a: Any, n: int | None = None, axis: int = -1, norm: _Norm = None, out: None = None) -> Tensor: ...
def irfft(a: Any, n: int | None = None, axis: int = -1, norm: _Norm = None, out: None = None) -> Tensor: ...
def hfft(a: Any, n: int | None = None, axis: int = -1, norm: _Norm = None, out: None = None) -> Tensor: ...
def ihfft(a: Any, n: int | None = None, axis: int = -1, norm: _Norm = None, out: None = None) -> Tensor: ...
def rfftn(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] | None = None, norm: _Norm = None,
          out: None = None) -> Tensor: ...
def irfftn(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] | None = None, norm: _Norm = None,
           out: None = None) -> Tensor: ...
def rfft2(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] = (-2, -1), norm: _Norm = None,
          out: None = None) -> Tensor: ...
def irfft2(a: Any, s: Sequence[int] | None = None, axes: Sequence[int] = (-2, -1), norm: _Norm = None,
           out: None = None) -> Tensor: ...
