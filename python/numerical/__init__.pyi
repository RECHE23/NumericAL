"""NumericAL — a generic, header-only numerical library, exposed to Python (see the module's docstring)."""
from collections.abc import Callable, Sequence
from typing import Any, Literal, overload

from numerical import fft as fft
from numerical._numerical import Tensor as Tensor
from numerical._numerical import error as error
from numerical._numerical import get_num_threads as get_num_threads

_Dtype = Literal["float64", "complex128", "float32", "complex64"]
_Number = float | complex
_GemmPath = Literal["portable", "neon", "avx2", "avx512", "amx"]

#: Anything :func:`asarray` reads: a Tensor, an object with an ``__array_interface__``, a nested list or tuple of
#: numbers, or a number.
_ArrayLike = Any

__all__ = [
    "Tensor", "einsum", "solve", "asarray", "error", "LinAlgError",
    "determinant", "det", "slogdet", "inverse", "inv", "solve_banded", "solveh_banded", "expm", "sqrtm", "polar",
    "solve_sylvester", "solve_continuous_lyapunov", "solve_lyapunov", "solve_discrete_lyapunov", "lstsq", "pinv",
    "matrix_rank", "cholesky", "qr", "eig",
    "eigvals", "eigh", "eigvalsh", "svd", "svdvals", "norm", "vector_norm", "matrix_norm", "cond", "matrix_power", "multi_dot",
    "trace", "outer", "cross", "tensordot", "vecdot", "conj", "conjugate", "matmul",
    "array_equal", "set_num_threads", "get_num_threads", "gemm_path", "limit_gemm_path",
    "get_include", "get_config", "blas_library",
    "schur", "solve_triangular", "lu_factor", "lu_solve", "cho_factor", "cho_solve", "LUFactor", "CholeskyFactor",
    "sum", "mean", "max", "min", "reshape", "full", "zeros", "ones", "eye", "arange", "linspace",
    "exp", "log", "sqrt", "sin", "cos", "tan", "tanh", "absolute", "power",
    "diagonal", "matrix_transpose", "tensorsolve", "tensorinv",
]
__version__: str

class LinAlgError(error, ValueError): ...

def set_num_threads(n: int) -> None: ...
def gemm_path() -> _GemmPath: ...
def limit_gemm_path(most: _GemmPath) -> _GemmPath: ...
def get_include() -> str: ...
def get_config() -> dict[str, Any]: ...
def blas_library() -> str | None: ...
def array_equal(a: _ArrayLike, b: _ArrayLike) -> bool: ...
def asarray(obj: _ArrayLike, dtype: _Dtype | None = None) -> Tensor: ...
def einsum(subscripts: str, /, *operands: _ArrayLike) -> Tensor: ...
def solve(a: _ArrayLike, b: _ArrayLike, /) -> Tensor: ...
def determinant(a: _ArrayLike, /) -> _Number | Tensor: ...
det = determinant
def slogdet(a: _ArrayLike, /) -> tuple[_Number, float] | tuple[Tensor, Tensor]: ...
def inverse(a: _ArrayLike, /) -> Tensor: ...
inv = inverse
_Uplo = Literal["L", "U", "l", "u"]
def lstsq(a: _ArrayLike, b: _ArrayLike, rcond: float | None = None) -> tuple[Tensor, Tensor, int, Tensor]: ...
def pinv(a: _ArrayLike, rcond: float | None = None, hermitian: bool = False, *, rtol: float | None = None) -> Tensor: ...
def eigvalsh(a: _ArrayLike, UPLO: _Uplo = "L", *, b: _ArrayLike | None = None) -> Tensor: ...
def eig(a: _ArrayLike) -> tuple[Tensor, Tensor]: ...
def matmul(x1: _ArrayLike, x2: _ArrayLike, /) -> Any: ...
def eigvals(a: _ArrayLike) -> Tensor: ...
def matrix_rank(
    A: _ArrayLike, tol: float | None = None, hermitian: bool = False, *, rtol: float | None = None
) -> int | list[Any]: ...
@overload
def schur(a: _ArrayLike, output: Literal["real", "r", "complex", "c"] = "real", lwork: int | None = None,
          overwrite_a: bool = False, sort: None = None, check_finite: bool = True) -> tuple[Tensor, Tensor]: ...
@overload
def schur(a: _ArrayLike, output: Literal["real", "r", "complex", "c"] = "real", lwork: int | None = None,
          overwrite_a: bool = False, *, sort: Literal["lhp", "rhp", "iuc", "ouc"] | Callable[..., Any],
          check_finite: bool = True) -> tuple[Tensor, Tensor, int]: ...
def cholesky(a: _ArrayLike, /, *, upper: bool = False) -> Tensor: ...
_Trans = Literal[0, 1, 2, "N", "T", "C"]
def solve_banded(l_and_u: tuple[int, int], ab: _ArrayLike, b: _ArrayLike, overwrite_ab: bool = False, overwrite_b: bool = False,
                 check_finite: bool = True) -> Tensor: ...
def solveh_banded(ab: _ArrayLike, b: _ArrayLike, overwrite_ab: bool = False, overwrite_b: bool = False, lower: bool = False,
                  check_finite: bool = True) -> Tensor: ...
def expm(A: _ArrayLike) -> Tensor: ...
def sqrtm(A: _ArrayLike) -> Tensor: ...
def polar(a: _ArrayLike, side: Literal["right", "left"] = "right") -> tuple[Tensor, Tensor]: ...
def solve_sylvester(a: _ArrayLike, b: _ArrayLike, q: _ArrayLike) -> Tensor: ...
def solve_continuous_lyapunov(a: _ArrayLike, q: _ArrayLike) -> Tensor: ...
def solve_lyapunov(a: _ArrayLike, q: _ArrayLike) -> Tensor: ...
def solve_discrete_lyapunov(a: _ArrayLike, q: _ArrayLike, method: Literal["direct", "bilinear"] | None = None) -> Tensor: ...
def solve_triangular(a: _ArrayLike, b: _ArrayLike, trans: _Trans = 0, lower: bool = False, unit_diagonal: bool = False,
                     overwrite_b: bool = False, check_finite: bool = True) -> Tensor: ...
class LUFactor(tuple[Tensor, tuple[int, ...]]):
    def __new__(cls, lu: Tensor, piv: tuple[int, ...]) -> LUFactor: ...
    @property
    def lu(self) -> Tensor: ...
    @property
    def piv(self) -> tuple[int, ...]: ...
    def solve(self, b: _ArrayLike, trans: _Trans = 0) -> Tensor: ...
def lu_factor(a: _ArrayLike, overwrite_a: bool = False, check_finite: bool = True) -> LUFactor: ...
def lu_solve(lu_and_piv: tuple[_ArrayLike, Sequence[int]], b: _ArrayLike, trans: _Trans = 0, overwrite_b: bool = False,
             check_finite: bool = True) -> Tensor: ...
class CholeskyFactor(tuple[Tensor, bool]):
    def __new__(cls, c: Tensor, lower: bool) -> CholeskyFactor: ...
    @property
    def c(self) -> Tensor: ...
    @property
    def lower(self) -> bool: ...
    def solve(self, b: _ArrayLike) -> Tensor: ...
def cho_factor(a: _ArrayLike, lower: bool = False, overwrite_a: bool = False, check_finite: bool = True) -> CholeskyFactor: ...
def cho_solve(c_and_lower: tuple[_ArrayLike, bool], b: _ArrayLike, overwrite_b: bool = False, check_finite: bool = True) -> Tensor: ...
@overload
def qr(a: _ArrayLike, mode: Literal["reduced", "complete"] = "reduced") -> tuple[Tensor, Tensor]: ...
@overload
def qr(a: _ArrayLike, mode: Literal["r"]) -> Tensor: ...
def eigh(
    a: _ArrayLike,
    UPLO: _Uplo = "L",
    *,
    b: _ArrayLike | None = None,
    method: Literal["divide_and_conquer", "tridiagonal_ql", "jacobi"] = "divide_and_conquer",
) -> tuple[Tensor, Tensor]: ...
_SvdMethod = Literal["divide_and_conquer", "bidiagonal_qr", "jacobi"]
@overload
def svd(
    a: _ArrayLike,
    full_matrices: bool = True,
    compute_uv: Literal[True] = True,
    hermitian: bool = False,
    *,
    method: _SvdMethod = "divide_and_conquer",
) -> tuple[Tensor, Tensor, Tensor]: ...
@overload
def svd(
    a: _ArrayLike,
    full_matrices: bool,
    compute_uv: Literal[False],
    hermitian: bool = False,
    *,
    method: _SvdMethod = "divide_and_conquer",
) -> Tensor: ...
@overload
def svd(
    a: _ArrayLike,
    full_matrices: bool = True,
    *,
    compute_uv: Literal[False],
    hermitian: bool = False,
    method: _SvdMethod = "divide_and_conquer",
) -> Tensor: ...
_Order = float | Literal["fro", "nuc"] | None
def svdvals(x: _ArrayLike, /) -> Tensor: ...
def norm(
    x: _ArrayLike, ord: _Order = None, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Tensor | float: ...
def vector_norm(
    x: _ArrayLike, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False, ord: float = 2
) -> Tensor | float: ...
def matrix_norm(x: _ArrayLike, /, *, keepdims: bool = False, ord: _Order = "fro") -> Tensor | float: ...
def cond(x: _ArrayLike, p: _Order = None) -> Tensor | float: ...
def matrix_power(a: _ArrayLike, n: int) -> Tensor: ...
def multi_dot(arrays: Sequence[_ArrayLike], *, out: None = None) -> Tensor | _Number: ...
def trace(x: _ArrayLike, /, *, offset: int = 0, dtype: _Dtype | None = None) -> Tensor | _Number: ...
def outer(x1: _ArrayLike, x2: _ArrayLike, /) -> Tensor: ...
def diagonal(x: _ArrayLike, /, *, offset: int = 0) -> Tensor: ...
def matrix_transpose(x: _ArrayLike, /) -> Tensor: ...
def tensorsolve(a: _ArrayLike, b: _ArrayLike, axes: tuple[int, ...] | None = None) -> Tensor: ...
def tensorinv(a: _ArrayLike, ind: int = 2) -> Tensor: ...
def cross(x1: _ArrayLike, x2: _ArrayLike, /, *, axis: int = -1) -> Tensor: ...
def tensordot(x1: _ArrayLike, x2: _ArrayLike, /, *, axes: int | tuple[Any, Any] = 2) -> Tensor | _Number: ...
def vecdot(x1: _ArrayLike, x2: _ArrayLike, /, *, axis: int = -1) -> Tensor | _Number: ...
def conj(x: _ArrayLike) -> Tensor: ...
def conjugate(x: _ArrayLike) -> Tensor: ...
def sum(a: _ArrayLike, axis: int | tuple[int, ...] | None = None, keepdims: bool = False) -> Tensor | _Number: ...
def mean(a: _ArrayLike, axis: int | tuple[int, ...] | None = None, keepdims: bool = False) -> Tensor | _Number: ...
def max(a: _ArrayLike, axis: int | tuple[int, ...] | None = None, keepdims: bool = False) -> Tensor | float: ...
def min(a: _ArrayLike, axis: int | tuple[int, ...] | None = None, keepdims: bool = False) -> Tensor | float: ...
def reshape(a: _ArrayLike, shape: int | Sequence[int]) -> Tensor: ...
def full(shape: int | Sequence[int], value: _Number, dtype: _Dtype | None = None) -> Tensor: ...
def zeros(shape: int | Sequence[int], dtype: _Dtype = "float64") -> Tensor: ...
def ones(shape: int | Sequence[int], dtype: _Dtype = "float64") -> Tensor: ...
def eye(n: int, dtype: _Dtype = "float64") -> Tensor: ...
def arange(start: float, stop: float | None = None, step: float = 1.0) -> Tensor: ...
def linspace(start: float, stop: float, num: int = 50) -> Tensor: ...
def exp(a: _ArrayLike) -> Tensor: ...
def log(a: _ArrayLike) -> Tensor: ...
def sqrt(a: _ArrayLike) -> Tensor: ...
def sin(a: _ArrayLike) -> Tensor: ...
def cos(a: _ArrayLike) -> Tensor: ...
def tan(a: _ArrayLike) -> Tensor: ...
