# The sdist is built on any platform without a wheel: it carries every file the build
# reads (the headers the binding compiles against) and the tests that check it, never a
# compiled extension left in the tree.
graft include
recursive-include python/src *.cpp
include python/numerical/py.typed python/numerical/__init__.pyi python/numerical/_numerical.pyi
recursive-include python/tests *.py
include README.md LICENSE NOTICE CHANGELOG.md
global-exclude *.so *.pyd *.pyc
prune python/tests/__pycache__
